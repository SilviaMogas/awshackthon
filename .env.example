# =============================================================================
# Health Response Agent - environment configuration example
# Copy to `.env` and adjust. NEVER put AWS credentials or secrets in any
# variable prefixed with NEXT_PUBLIC_ / PUBLIC_ (those are exposed to the client).
# =============================================================================

# ---- Public (safe to expose to the browser) --------------------------------
PUBLIC_APP_NAME=Health Response Agent
PUBLIC_DEMO_MODE=true
PUBLIC_API_BASE_URL=
PUBLIC_DEFAULT_COUNTRY=SA
PUBLIC_DEFAULT_LANGUAGE=en

# Next.js-style equivalents (kept for parity with the original spec). The app
# reads PUBLIC_* first, then falls back to these.
NEXT_PUBLIC_APP_NAME=Health Response Agent
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_COUNTRY=SA
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# ---- Server ----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# Force every backend service to use its mock adapter (true) or attempt the
# real integration when an endpoint URL is configured (false).
SERVICE_MODE=mock

# Simulated processing latency for mock adapters, in milliseconds.
MOCK_LATENCY_MS=1200

# ---- AWS (server-side only; NEVER expose via PUBLIC_/NEXT_PUBLIC_) ----------
AWS_REGION=
AWS_BEDROCK_MODEL_ID=
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=
DYNAMODB_SESSIONS_TABLE=
DYNAMODB_AUDIT_TABLE=
LOCATION_PLACE_INDEX=

# ---- Downstream medical endpoints (server-side only) ------------------------
# When set AND SERVICE_MODE!=mock, the corresponding real adapter is used.
TRIAGE_ENDPOINT=
EMERGENCY_SCREENING_ENDPOINT=
MEDICAL_PROVIDER_ENDPOINT=
EMERGENCY_ESCALATION_ENDPOINT=
